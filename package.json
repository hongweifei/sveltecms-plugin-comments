{
	"name": "sveltecms-plugin-comments",
	"version": "0.4.4",
	"type": "module",
	"private": true,
	"description": "SvelteCMS 官方评论插件（独立仓库，经插件市场分发）",
	"engines": {
		"node": ">=22.17.0"
	},
	"scripts": {
		"ensure": "node scripts/ensure-host.mjs",
		"dev": "node scripts/ensure-host.mjs && concurrently -k -n host,watch -c cyan,green \"pnpm --dir .sveltecms exec vite dev --port 5178 --strictPort\" \"node scripts/sync-watch.mjs\"",
		"test": "node scripts/ensure-host.mjs && vitest run",
		"test:watch": "node scripts/ensure-host.mjs && vitest",
		"e2e": "node scripts/ensure-host.mjs && playwright test",
		"check": "node scripts/ensure-host.mjs && svelte-check --tsconfig ./tsconfig.json",
		"package": "node scripts/package.mjs"
	},
	"devDependencies": {
		"@libsql/client": "^0.17.4",
		"@lucide/svelte": "^1.76.0",
		"@playwright/test": "1.61.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"adm-zip": "^0.6.0",
		"concurrently": "^9.1.0",
		"drizzle-orm": "^0.45.2",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"ua-parser-js": "^2.0.10",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "ignore"
		}
	}
}
