{
	// 类型环境借用仓内宿主 .sveltecms/：extends 宿主由 SvelteKit 3 生成的
	// $app/tsconfig（rootDirs 指向 .sveltecms/ 与其 .svelte-kit/types，
	// 自带 $app/types，即 SvelteKit 的显式环境变量与模块声明）。
	// paths 子级整体覆盖父级：#lib 需重新声明指向 .sveltecms/src/lib。
	// 宿主的 src/app.d.ts（Locals 增强）与路由 $types 必须显式 include。
	// 共享库锁到本仓 node_modules，防止双实例 brand 冲突（svelte / drizzle-orm）。
	// 前提：宿主跑过 svelte-kit sync（pnpm check 的 ensure 步骤自动保证）。
	"extends": "./.sveltecms/node_modules/$app/tsconfig.json",
	"compilerOptions": {
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"strict": true,
		"noEmit": true,
		"paths": {
			"#lib": ["./.sveltecms/src/lib/index.ts"],
			"#lib/*": ["./.sveltecms/src/lib/*"],
			"drizzle-orm": ["./node_modules/drizzle-orm"],
			"drizzle-orm/*": ["./node_modules/drizzle-orm/*"],
			"svelte": ["./node_modules/svelte"],
			"svelte/*": ["./node_modules/svelte/*"]
		}
	},
	"include": [
		// 宿主 SvelteKit 生成的路由 $types 与全局类型增强（Locals.user 等）
		".sveltecms/.svelte-kit/types/**/*.d.ts",
		".sveltecms/src/app.d.ts",
		"plugin/**/*.ts",
		"plugin/**/*.svelte"
	],
	"exclude": [".sveltecms/node_modules", ".sveltecms/data", ".sveltecms/build"]
}
